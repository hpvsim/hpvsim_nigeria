__pycache__/
*.pyc
*.sim
*.msim
*.obj
# Two-tier calibration artifacts (shrunk goes to results/, full to raw_results/)
!results/nigeria_pars.obj
!results/nigeria_pars_all.obj
!results/nigeria_calib.obj
# Scenario plot-ready CSV is small enough to commit; the full MultiSim .obj
# (~250 MB) stays gitignored and is regenerated by run_scenarios.py.
!results/nigeria_scenarios.csv
raw_results/*
!raw_results/.gitkeep
figures/*
!figures/.gitkeep
.DS_Store
